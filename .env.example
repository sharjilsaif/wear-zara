# PostgreSQL connection string (e.g. a free Neon database: https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign session tokens. Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Comma-separated emails that may publish/delete products in /admin.
# Everyone else sees the dashboard in read-only demo mode.
ADMIN_EMAILS="you@example.com"

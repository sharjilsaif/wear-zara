# PostgreSQL connection string (e.g. a free Neon database: https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign session tokens. Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Comma-separated emails that may publish/delete products in /admin.
# Everyone else is redirected away from /admin and gets 403 from admin APIs.
ADMIN_EMAILS="you@example.com"

# Optional: real contact details for the footer and contact page. Leave unset to hide them.
NEXT_PUBLIC_STORE_EMAIL=""
NEXT_PUBLIC_STORE_PHONE=""
NEXT_PUBLIC_STORE_ADDRESS=""

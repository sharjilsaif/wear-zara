// Prisma schema for Wear Zara — https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Customer account. Passwords are stored as bcrypt hashes.
model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  phone    String?

  avatar        Avatar?
  orders        Order[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  messages      ContactMessage[]
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Profile picture, kept in its own table so user queries never load image bytes by accident.
model Avatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt
}

/// Store department, e.g. "Men's Fashion" (slug: "mens-fashion").
/// Merchandising groups such as "best-selling" and "flash-sales" are categories too.
model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A product can belong to many categories (implicit many-to-many).
model Product {
  id       String @id @default(cuid())
  name     String
  price    Float
  imageUrl String
  rating   Int    @default(5)
  reviews  Int    @default(0)

  /// Original (pre-sale) price, shown struck-through when higher than `price`.
  discountPrice      Float?
  discountPercentage Int?

  categories     Category[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  productReviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A signed-in shopper's cart, synced across devices.
model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Orders keep a snapshot of the customer and items, so they survive product or account deletion.
model Order {
  id     String      @id @default(cuid())
  number String      @unique
  status OrderStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerName String
  email        String
  phone        String
  company      String?
  street       String
  apartment    String?
  city         String
  notes        String?

  paymentMethod String  @default("COD")
  couponCode    String?
  subtotal      Float
  discount      Float   @default(0)
  shipping      Float
  total         Float

  items OrderItem[]

  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name      String
  imageUrl  String
  unitPrice Float
  quantity  Int
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  description String?
  type        CouponType @default(PERCENT)
  /// Percentage (1–100) for PERCENT, amount in USD for FIXED.
  value       Float
  minSubtotal Float      @default(0)
  maxUses     Int?
  usedCount   Int        @default(0)
  active      Boolean    @default(true)
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  message String
  read    Boolean @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// A customer review. One per customer per product.
model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String

  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

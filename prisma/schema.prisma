// Prisma schema for Wear Zara — https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Customer account. Passwords are stored as bcrypt hashes.
model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Store department, e.g. "Men's Fashion" (slug: "mens-fashion").
/// Merchandising groups such as "best-selling" and "flash-sales" are categories too.
model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A product can belong to many categories (implicit many-to-many).
model Product {
  id       String @id @default(cuid())
  name     String
  price    Float
  imageUrl String
  rating   Int    @default(5)
  reviews  Int    @default(0)

  /// Original (pre-sale) price, shown struck-through when higher than `price`.
  discountPrice      Float?
  discountPercentage Int?

  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
